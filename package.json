{
	"name": "n8n-nodes-fantasypros",
	"version": "0.1.1",
	"description": "n8n community node for the official FantasyPros Public API v2",
	"license": "MIT",
	"homepage": "https://github.com/christopherjnelson/n8n-nodes-fantasypros#readme",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Christopher J. Nelson",
		"email": "christopherjnelson@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/christopherjnelson/n8n-nodes-fantasypros.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"format:check": "prettier --check credentials nodes test docs README.md package.json eslint.config.mjs .github/workflows",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:live": "FANTASYPROS_LIVE_TESTS=1 vitest run test/live",
		"release:check": "node scripts/release-check.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FantasyProsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/FantasyPros/FantasyPros.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.42.2",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "20.2.0",
		"typescript": "5.9.2",
		"vitest": "3.2.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
